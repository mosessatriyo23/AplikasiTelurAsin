{
  "name": "telur-asinnya-asin-nganenin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "admin:set-login": "node scripts/set-admin-login.cjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app components lib scripts tests",
    "test:integration": "node scripts/run-integration-tests.cjs",
    "test:coverage": "c8 --all --include='lib/**/*.ts' --include='app/api/**/*.ts' --exclude='**/*.d.ts' --reporter=text --reporter=html npm test",
    "test:e2e": "node scripts/run-e2e-tests.cjs",
    "quality": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run test:coverage && npm run test:e2e && npm run build && npx prisma validate && npm audit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "c8": "^12.0.0",
    "oxlint": "^1.89.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "deepmerge-ts": "^8.0.2"
  }
}
